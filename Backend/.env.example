# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://noesis:noesis@localhost:5432/noesis
TEST_DATABASE_URL=postgresql+psycopg://noesis:noesis@localhost:5432/noesis_test

# Uploaded PDFs are copied here under server-generated names.
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=50

# LLM: Groq free tier via its OpenAI-compatible API.
# Question text, recent chat history and retrieved PDF passages are sent to Groq.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1

# Embeddings run locally; PDF text is not sent anywhere for embedding.
EMBEDDING_PROVIDER=qwen3
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
# auto | cuda | cpu
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16

# Chunking (characters) and retrieval
CHUNK_SIZE=1800
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.3
HISTORY_MAX_MESSAGES=8

CORS_ORIGINS=["http://localhost:4200"]
